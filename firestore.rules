rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCR() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cr' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /system/{docId} {
      allow read: if true;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
                      request.resource.data.role == 'student' &&
                      request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt']);
      allow update: if isOwner(userId) && 
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.email == resource.data.email;

      // Subcollections under users
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId);
      }
      match /routines/{routineId} {
        allow read, write: if isOwner(userId);
      }
      match /studyProgress/{subjectId} {
        allow read, write: if isOwner(userId);
      }
      match /backupRecords/{recordId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /calendarEvents/{eventId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Global Calendar Events
    match /globalCalendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(eventId);
    }

    // Assessments and CTs (Shared)
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isCR();
    }

    // Memories Album (Shared)
    match /album/{imageId} {
      allow read: if isSignedIn();
      allow write: if isCR();
    }

    // Class Fund (Shared)
    match /classFund/{fundId} {
      allow read: if isSignedIn();
      allow write: if isCR();
    }

    // People Directory (Official)
    match /people/{personId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Batchmate Directory (Legacy/Shared)
    match /batchmates/{studentId} {
      allow read: if isSignedIn();
      allow write: if isCR();
    }
  }
}
